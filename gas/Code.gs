const SHEET_SENTENCES="Sentences",SHEET_RESULTS="Results";
function doGet(e){try{if(e.parameter.action==="getBank")return out({ok:true,sentences:getBank()});return out({ok:false,error:"Unknown action"});}catch(x){return out({ok:false,error:String(x)});}}
function doPost(e){try{const p=JSON.parse(e.postData.contents||"{}"),a=p.action;if(a==="teacherLogin"){pin(p.pin);return out({ok:true});}
if(a==="addSentences"){pin(p.pin);const s=tab(SHEET_SENTENCES);(p.sentences||[]).map(x=>String(x).trim()).filter(Boolean).forEach(x=>s.appendRow([Utilities.getUuid(),x,new Date()]));return out({ok:true});}
if(a==="deleteSentence"){pin(p.pin);const s=tab(SHEET_SENTENCES),v=s.getDataRange().getValues();for(let i=1;i<v.length;i++)if(String(v[i][0])===String(p.id)){s.deleteRow(i+1);return out({ok:true});}throw Error("題目不存在");}
if(a==="saveResult"){tab(SHEET_RESULTS).appendRow([new Date(),safe(p.className),safe(p.studentId),safe(p.studentName),Number(p.avgCompleteness)||0,Number(p.avgAccuracy)||0,Number(p.attempts)||0,JSON.stringify(p.details||[])]);return out({ok:true});}
if(a==="getGrades"){pin(p.pin);const rows=tab(SHEET_RESULTS).getDataRange().getValues().slice(1).filter(r=>(!p.className||String(r[1]).includes(p.className))&&(!p.studentId||String(r[2]).includes(p.studentId))).reverse().slice(0,500).map(r=>({timestamp:r[0] instanceof Date?Utilities.formatDate(r[0],Session.getScriptTimeZone(),"yyyy-MM-dd HH:mm"):String(r[0]),className:r[1],studentId:r[2],studentName:r[3],avgCompleteness:r[4],avgAccuracy:r[5],attempts:r[6]}));return out({ok:true,results:rows});}return out({ok:false,error:"Unknown action"});}catch(x){return out({ok:false,error:String(x)});}}
function setup(){const ss=SpreadsheetApp.getActiveSpreadsheet();let s=ss.getSheetByName(SHEET_SENTENCES);if(!s){s=ss.insertSheet(SHEET_SENTENCES);s.appendRow(["id","sentence","createdAt"]);s.setFrozenRows(1);}let r=ss.getSheetByName(SHEET_RESULTS);if(!r){r=ss.insertSheet(SHEET_RESULTS);r.appendRow(["timestamp","className","studentId","studentName","avgCompleteness","avgAccuracy","attempts","details"]);r.setFrozenRows(1);}if(!PropertiesService.getScriptProperties().getProperty("TEACHER_PIN"))PropertiesService.getScriptProperties().setProperty("TEACHER_PIN","請更換為自訂教師密碼");const seed=["Good morning. How are you today?","My name is Kevin.","I would like a glass of water, please.","Could you speak more slowly?","The weather is beautiful this afternoon.","I usually walk to school with my friends.","Practice makes progress every day.","Please read the sentence aloud.","I enjoy learning English because it is useful.","Thank you for your time and attention."];if(s.getLastRow()===1)seed.forEach(x=>s.appendRow([Utilities.getUuid(),x,new Date()]));}
function getBank(){return tab(SHEET_SENTENCES).getDataRange().getValues().slice(1).filter(r=>r[1]).map(r=>({id:String(r[0]),text:String(r[1])}));}
function tab(n){const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(n);if(!s)throw Error("請先執行 setup()");return s;}
function pin(v){const p=PropertiesService.getScriptProperties().getProperty("TEACHER_PIN");if(!p||p==="請更換為自訂教師密碼"||String(v||"")!==p)throw Error("教師 PIN 錯誤或尚未設定");}
function safe(v){return String(v||"").replace(/[<>]/g,"").slice(0,100);}
function out(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON);}